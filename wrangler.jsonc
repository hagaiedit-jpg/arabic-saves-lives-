{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arabicsaveslives",
  "compatibility_date": "2026-05-07",
  "observability": {
    "enabled": true
  },
  // The Worker only answers /api/sign-upload; everything else is the static site.
  "main": "worker/index.js",
  // Keep variables added in the Cloudflare dashboard (e.g. the Cloudinary keys)
  // when a new version deploys from git.
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "vars": {
    "SUPABASE_URL": "https://ukynfcwxsrzpuqecfjuz.supabase.co",
    "SUPABASE_KEY": "sb_publishable_ugMP9beQh9-TJVGL3uzIAA_xhAgWJQP",
    "CLOUDINARY_CLOUD": "dvjuflgqs",
    "CLOUDINARY_PRESET": "arabic_audio"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
